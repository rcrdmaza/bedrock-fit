# Absolute URL of the deployed site, used for canonical/OG metadata,
# robots.txt and sitemap.xml. Optional — defaults to https://www.bedrock.fit
# (the primary production domain; apex bedrock.fit 308-redirects to www).
# Set a per-environment value on staging (e.g. the Vercel preview URL).
NEXT_PUBLIC_SITE_URL=https://www.bedrock.fit

# GA4 measurement ID for the bedrock.fit property. Optional — defaults to
# G-ES80M9ZLC4 in src/app/layout.tsx. The tag only renders in production
# builds, so `next dev` never reports.
#
# Do NOT point this at property 356092132 — that one serves mrtask.com and
# fctech.xyz. Confirm by adding the `hostName` dimension to any GA4 report.
NEXT_PUBLIC_GA_ID=G-ES80M9ZLC4
