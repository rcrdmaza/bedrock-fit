# Absolute URL of the deployed site, used for canonical/OG metadata,
# robots.txt and sitemap.xml. Optional — defaults to https://www.bedrock.fit
# (the primary production domain; apex bedrock.fit 308-redirects to www).
# Set a per-environment value on staging (e.g. the Vercel preview URL).
NEXT_PUBLIC_SITE_URL=https://www.bedrock.fit
